
/* ================= COMMUNITY SECTION ================= */
.community-section {
    position: relative;
    padding: 6rem 2rem;
    overflow: hidden;
    width: 100%;
    text-align: center;
    color: white; /* Always white text due to dark bg */
}

/* Background Image with Overlay */
.community-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    z-index: 0;
}

.community-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(22, 22, 22, 0.9) 0%, rgba(22, 22, 22, 0.7) 100%);
    z-index: 1;
}

.community-content {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
}

/* Force dark mode styles for header inside community section */
.dark-mode-force .section-title {
    color: white !important;
}

.dark-mode-force .section-desc {
    color: rgba(255, 255, 255, 0.8) !important;
}

.community-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
}

/* Responsive Community Grid */
@media screen and (max-width: 900px) {
    .community-grid {
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }
}

.community-card {
    background: rgba(255, 255, 255, 0.05); /* Glassmorphish */
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    text-align: center;
    text-decoration: none !important;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    color: white !important;
}

.community-card:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-5px);
    border-color: var(--ct-color-primary);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}

.community-icon {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
}

.community-card h3 {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 0.8rem;
    color: white;
}

.community-card p {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 2rem;
    flex-grow: 1; /* Push link to bottom */
}

.community-link-text {
    font-weight: 600;
    color: var(--ct-color-primary);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.9rem;
    transition: color 0.2s;
}

.community-card:hover .community-link-text {
    color: #FF7A00; /* Lighter primary on hover */
}
